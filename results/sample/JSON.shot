 "source_mode": "sample",
 "engine": "duckdb 1.5.6",
 "config": {
  "sql_dialect": "Spark SQL style (+ DuckDB shims in sql/00), run on DuckDB",
  "grain": "fact_sales = one net sales line (invoice x stock code); customers = identified CustomerID with a net sale",
  "revenue": "net merchandise revenue = quantity x unit price (GBP) on valid sales lines, after removing lines exactly reversed by a credit note; postage/fees/manual/discount/voucher codes excluded",
  "cleaning": "exact duplicates removed; C-invoices -> returns; A-invoices, price <= 0, quantity <= 0 on sales invoices and non-product codes removed; missing CustomerID kept as guest revenue; country labels standardised",
  "outlier_rule": "quantity / line revenue above Q3 + 1.5 IQR and line revenue above P99.9 are flagged and kept",
  "rfm": "snapshot = 2011-12-10 (day after the last invoice); R = days since last order, F = distinct orders, M = net revenue; tie-aware quintile scores 1..5 (1 + floor(5*(rank-1)/n)); 9 named segments from R/F (+M)",
  "cohort": "cohort = month of first net purchase; retention = share of the cohort with a purchase N months later",
  "sample_rule": "data/raw: every line of customers with crc32(CustomerID) % 20 = 0, every line of guest invoices with crc32(InvoiceNo) % 40 = 0, plus the first examples of each cleaning rule (scripts/make_sample.py)"
 },
